DATABASE_URL=postgresql://postgres:password@localhost:5432/docmind
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/docmind_test
JWT_SECRET=change_this_to_a_long_random_string
CLIENT_URL=http://localhost:5173
PORT=5000
DB_SSL=false

# --- AI provider ---
# "mock" works offline with no API key (good for development). To use a real model, set
# LLM_PROVIDER=groq, add a free key from https://console.groq.com and keep the values below.
# Any OpenAI-compatible API works: change LLM_BASE_URL, LLM_MODEL and LLM_API_KEY.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
# Reasoning models think before answering. Keep that short and allow enough output tokens:
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=1200
# Groq retires models from time to time. List the current ones with: GET https://api.groq.com/openai/v1/models
RATE_LIMIT_PER_MIN=15
# Documents up to this many chunks (about 900 characters each) are sent to the model in full
FULL_CONTEXT_MAX_CHUNKS=8

# How the AI may answer:
#   assisted - facts come only from your documents; opinions and general questions (e.g. "what is JWT") are also answered and labelled
#   grounded - answers come only from your documents; anything else gets "not found"
ANSWER_MODE=assisted
